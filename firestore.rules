rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Hardened Helpers
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidHttpUrl(url, maxLen) {
      return url is string && url.size() >= 8 && url.size() <= maxLen && url.matches('^https?://.*');
    }

    // -------------------------------------------------------------------------
    // Entity Validation Blueprints
    // -------------------------------------------------------------------------
    function isValidCategoriesList(listVal) {
      return listVal is list
        && listVal.size() <= 7
        && listVal.hasOnly([
          'electronics',
          'fashion',
          'home-goods',
          'travel',
          'groceries',
          'entertainment',
          'beauty-health'
        ]);
    }

    function isValidOfferTypesList(listVal) {
      return listVal is list
        && listVal.size() <= 3
        && listVal.hasOnly(['codice-sconto', 'cashback', 'prova-gratis']);
    }

    function isValidSourcesList(listVal) {
      return listVal is list
        && listVal.size() <= 11
        && listVal.hasOnly([
          'buyon',
          'scontiomaggio',
          'letyshops',
          'bestshopping',
          'scontrinofelice',
          'widilo',
          'pgperte',
          'dimmicosacerchi',
          'codicerisparmio',
          'cashbackdeals',
          'simplybestcoupons'
        ]);
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'email',
          'preferredCategories',
          'preferredOfferTypes',
          'preferredSources',
          'notifyOnNewDeals',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'photoURL',
          'preferredCategories',
          'preferredOfferTypes',
          'preferredSources',
          'notifyOnNewDeals',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 80
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 160
        && (!('photoURL' in data) || data.photoURL == '' || isValidHttpUrl(data.photoURL, 500))
        && isValidCategoriesList(data.preferredCategories)
        && isValidOfferTypesList(data.preferredOfferTypes)
        && isValidSourcesList(data.preferredSources)
        && data.notifyOnNewDeals is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDealTagsList(listVal) {
      return listVal is list
        && listVal.size() >= 1
        && listVal.size() <= 4
        && listVal.hasOnly([
          'electronics',
          'fashion',
          'home-goods',
          'travel',
          'groceries',
          'entertainment',
          'beauty-health'
        ]);
    }

    function isValidSavedDeal(data, userId, dealId) {
      return data.keys().hasAll([
          'id',
          'userId',
          'title',
          'merchant',
          'description',
          'category',
          'tags',
          'sourceId',
          'sourceName',
          'offerUrl',
          'rewardLabel',
          'savedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'userId',
          'title',
          'merchant',
          'description',
          'category',
          'tags',
          'sourceId',
          'sourceName',
          'offerUrl',
          'rewardLabel',
          'couponCode',
          'couponHint',
          'imageUrl',
          'note',
          'expiresAt',
          'reminderEnabled',
          'reminderNotifiedAt',
          'savedAt'
        ])
        && isValidId(data.id)
        && data.id == dealId
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.userId == userId
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 200
        && data.merchant is string
        && data.merchant.size() >= 1
        && data.merchant.size() <= 80
        && data.description is string
        && data.description.size() <= 400
        && data.category in ['codice-sconto', 'cashback', 'prova-gratis']
        && isValidDealTagsList(data.tags)
        && data.sourceId in [
          'buyon',
          'scontiomaggio',
          'letyshops',
          'bestshopping',
          'scontrinofelice',
          'widilo',
          'pgperte',
          'dimmicosacerchi',
          'codicerisparmio',
          'cashbackdeals',
          'simplybestcoupons'
        ]
        && data.sourceName is string
        && data.sourceName.size() >= 1
        && data.sourceName.size() <= 60
        && isValidHttpUrl(data.offerUrl, 600)
        && data.rewardLabel is string
        && data.rewardLabel.size() >= 1
        && data.rewardLabel.size() <= 60
        && (!('couponCode' in data) || (data.couponCode is string && data.couponCode.size() <= 50))
        && (!('couponHint' in data) || (data.couponHint is string && data.couponHint.size() <= 30))
        && (!('imageUrl' in data) || data.imageUrl == '' || isValidHttpUrl(data.imageUrl, 600))
        && (!('note' in data) || (data.note is string && data.note.size() <= 280))
        && (!('expiresAt' in data) || data.expiresAt == '' || (data.expiresAt is string && data.expiresAt.size() >= 10 && data.expiresAt.size() <= 40))
        && (!('reminderEnabled' in data) || data.reminderEnabled is bool)
        && (!('reminderNotifiedAt' in data) || data.reminderNotifiedAt == '' || (data.reminderNotifiedAt is string && data.reminderNotifiedAt.size() <= 40))
        && data.savedAt is timestamp;
    }

    function isValidRemovedDeal(data, userId, dealId) {
      return data.keys().hasAll([
          'id',
          'userId',
          'title',
          'merchant',
          'description',
          'category',
          'tags',
          'sourceId',
          'sourceName',
          'offerUrl',
          'rewardLabel',
          'removedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'userId',
          'title',
          'merchant',
          'description',
          'category',
          'tags',
          'sourceId',
          'sourceName',
          'offerUrl',
          'rewardLabel',
          'couponCode',
          'couponHint',
          'imageUrl',
          'note',
          'expiresAt',
          'removedAt'
        ])
        && isValidId(data.id)
        && data.id == dealId
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.userId == userId
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 200
        && data.merchant is string
        && data.merchant.size() >= 1
        && data.merchant.size() <= 80
        && data.description is string
        && data.description.size() <= 400
        && data.category in ['codice-sconto', 'cashback', 'prova-gratis']
        && isValidDealTagsList(data.tags)
        && data.sourceId in [
          'buyon',
          'scontiomaggio',
          'letyshops',
          'bestshopping',
          'scontrinofelice',
          'widilo',
          'pgperte',
          'dimmicosacerchi',
          'codicerisparmio',
          'cashbackdeals',
          'simplybestcoupons'
        ]
        && data.sourceName is string
        && data.sourceName.size() >= 1
        && data.sourceName.size() <= 60
        && isValidHttpUrl(data.offerUrl, 600)
        && data.rewardLabel is string
        && data.rewardLabel.size() >= 1
        && data.rewardLabel.size() <= 60
        && (!('couponCode' in data) || (data.couponCode is string && data.couponCode.size() <= 50))
        && (!('couponHint' in data) || (data.couponHint is string && data.couponHint.size() <= 30))
        && (!('imageUrl' in data) || data.imageUrl == '' || isValidHttpUrl(data.imageUrl, 600))
        && (!('note' in data) || (data.note is string && data.note.size() <= 280))
        && (!('expiresAt' in data) || data.expiresAt == '' || (data.expiresAt is string && data.expiresAt.size() >= 10 && data.expiresAt.size() <= 40))
        && data.removedAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Collection: /users/{userId} (Strict PII Isolation)
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'photoURL',
          'preferredCategories',
          'preferredOfferTypes',
          'preferredSources',
          'notifyOnNewDeals',
          'updatedAt'
        ]);

      allow delete: if false;

      // -----------------------------------------------------------------------
      // Subcollection: /users/{userId}/savedDeals/{dealId}
      // -----------------------------------------------------------------------
      match /savedDeals/{dealId} {
        allow get: if isValidId(userId)
          && isValidId(dealId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId));

        allow list: if isOwner(userId)
          && resource.data.userId == request.auth.uid;

        allow create: if isVerified()
          && isValidId(userId)
          && isValidId(dealId)
          && isOwner(userId)
          && isValidSavedDeal(incoming(), userId, dealId)
          && incoming().savedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isVerified()
          && isValidId(userId)
          && isValidId(dealId)
          && isOwner(userId)
          && isValidSavedDeal(incoming(), userId, dealId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().savedAt == existing().savedAt
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'note',
            'expiresAt',
            'reminderEnabled',
            'reminderNotifiedAt'
          ])
          && exists(/databases/$(database)/documents/users/$(userId));

        allow delete: if isVerified()
          && isValidId(userId)
          && isValidId(dealId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId));
      }

      // -----------------------------------------------------------------------
      // Subcollection: /users/{userId}/removedDeals/{dealId} (Storico)
      // -----------------------------------------------------------------------
      match /removedDeals/{dealId} {
        allow get: if isValidId(userId)
          && isValidId(dealId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId));

        allow list: if isOwner(userId)
          && resource.data.userId == request.auth.uid;

        allow create: if isVerified()
          && isValidId(userId)
          && isValidId(dealId)
          && isOwner(userId)
          && isValidRemovedDeal(incoming(), userId, dealId)
          && incoming().removedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isVerified()
          && isValidId(userId)
          && isValidId(dealId)
          && isOwner(userId)
          && isValidRemovedDeal(incoming(), userId, dealId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().removedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title',
            'merchant',
            'description',
            'category',
            'tags',
            'sourceId',
            'sourceName',
            'offerUrl',
            'rewardLabel',
            'couponCode',
            'couponHint',
            'imageUrl',
            'note',
            'expiresAt',
            'removedAt'
          ])
          && exists(/databases/$(database)/documents/users/$(userId));

        allow delete: if isVerified()
          && isValidId(userId)
          && isValidId(dealId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId));
      }
    }
  }
}
